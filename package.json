{
	"name": "vlab",
	"module": "index.ts",
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@clack/prompts": "^1.5.1",
		"@types/bun": "^1.3.14",
		"concurrently": "^9.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"node-ssh": "^13.2.1",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,css}": [
			"biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"private": true,
	"trustedDependencies": [
		"msgpackr-extract"
	],
	"scripts": {
		"dev": "concurrently -n web,manager,worker -c cyan,magenta,yellow \"bun web dev\" \"bun manager dev\" \"bun worker dev\"",
		"scripts:tmux": "bun run scripts/dev.ts",
		"scripts:db-transfer": "bun run scripts/db-transfer.ts",
		"scripts:sync-command-reference": "bun run scripts/sync-command-reference.ts",
		"web": "bun --filter @vlab/web",
		"manager": "bun --filter @vlab/manager",
		"worker": "bun --filter @vlab/worker",
		"check": "biome check --write .",
		"check:ci": "biome check .",
		"lint": "biome lint --write --unsafe .",
		"format": "biome format --write .",
		"typecheck": "bun --filter='*' run typecheck",
		"test:unit": "bun --filter @vlab/evaluator test",
		"test:module-docs": "bun test tests/modules-e2e/src/module-docs.test.ts",
		"validate-readmes": "bun test tests/readme-validator/validate.test.ts",
		"prepare": "husky"
	},
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*/*",
		"tests/*"
	]
}
