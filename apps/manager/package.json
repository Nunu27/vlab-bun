{
	"name": "@vlab/manager",
	"version": "1.0.50",
	"scripts": {
		"dev": "bun run --watch src/index.ts serve | pino-pretty",
		"seed": "bun run src/index.ts seed | pino-pretty",
		"backup": "bun run src/index.ts backup | pino-pretty",
		"restore": "bun run src/index.ts restore | pino-pretty",
		"sync-modules": "bun run src/index.ts sync-modules | pino-pretty",
		"build": "bun build src/index.ts --compile --minify --outfile ../../out/manager/app && cp -r migrations ../../out/manager/migrations",
		"typecheck": "tsc --noEmit",
		"drizzle:generate": "drizzle-kit generate",
		"drizzle:migrate": "drizzle-kit migrate",
		"drizzle:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@bogeychan/elysia-logger": "^0.1.10",
		"@elysiajs/openapi": "^1.4.15",
		"@elysiajs/static": "^1.4.10",
		"@jawit/common": "workspace:*",
		"@jawit/elysia-caching": "workspace:*",
		"@jawit/paginator": "workspace:*",
		"@msgpack/msgpack": "^3.1.3",
		"@sinclair/typebox": "^0.34.52",
		"@socket.io/bun-engine": "^0.1.1",
		"@socket.io/redis-streams-adapter": "^0.3.1",
		"@vlab/evaluator": "workspace:*",
		"@vlab/grpc": "workspace:*",
		"@vlab/shared": "workspace:*",
		"@vlab/ws": "workspace:*",
		"bcryptjs": "^2.4.3",
		"bullmq": "^5.81.3",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"elysia": "1.4.28",
		"elysia-helmet": "^3.1.0",
		"fast-xml-parser": "^5.11.0",
		"guacamole-lite": "^1.2.0",
		"ioredis": "5.11.1",
		"nice-grpc": "^2.1.17",
		"pino": "^10.3.1",
		"s3mini": "^0.9.5",
		"socket.io": "^4.8.3",
		"socket.io-msgpack-parser": "^3.0.2",
		"waycast": "^3.0.2"
	},
	"devDependencies": {
		"@types/bun": "1.3.11",
		"@types/ws": "^8.18.1",
		"drizzle-kit": "^0.31.10"
	},
	"module": "src/index.js"
}
